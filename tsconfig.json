{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false
  },
  "include": [
    "index.ts",
    "types.ts",
    "adapters/**/*.ts",
    "authz/**/*.ts",
    "identity/**/*.ts",
    "rate-limit/**/*.ts",
    "audit/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "test/**"]
}
